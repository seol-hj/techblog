# 엔드포인트 (1)

filters:
  and:
    - note["base"] == link("엔드포인트 (1).base")
properties:
  file.name:
    displayName: 기능
  설명:
    displayName: 설명
  사용자:
    displayName: 사용자
  Method:
    displayName: Method
  카테고리:
    displayName: 카테고리
  기타:
    displayName: 기타
  URL:
    displayName: URL
  param:
    displayName: param
views:
  - type: table
    name: Table View
    order:
      - file.name
      - 설명
      - 사용자
      - Method
      - 카테고리
      - 기타
      - URL
      - param
